  "feature_notes": {
    "lag_k": "выдача k дней назад; дни сбоев (is_disrupted) заменены на пропуск",
    "roll_mean_7 / roll_mean_28": "среднее за 7 / 28 дней по D−1 включительно, без дней сбоев",
    "*_lag1": "погода вчера (D−1)",
    "fx_shock_last3": "был ли скачок курса за D−3…D−1",
