{
  "model": "LightGBM (LGBMRegressor), признаки из notebooks/03_optimization.ipynb",
  "target": "cash_out — выдача наличных банкоматом за день, сом",
  "forecast": "прогноз на день D, сделанный вечером дня D−1",
  "features": [
