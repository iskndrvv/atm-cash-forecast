    "is_ramadan",
    "is_weekend",
    "is_street",
    "fx_shock_last3",
    "lag_1",
    "lag_7",
    "lag_14",
    "roll_mean_7",
    "roll_mean_28",
    "temp_avg_lag1",
    "precip_mm_lag1",
    "snowfall_mm_lag1",
    "wind_max_lag1",
    "dom",
    "lag_28"
